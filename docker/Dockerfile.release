FROM scratch
ARG TARGETARCH
COPY samishisa-${TARGETARCH} /samishisa
COPY --chown=1000:1000 config /config
COPY --chown=1000:1000 data /data
WORKDIR /config
ENV SAMISHISA_DATA=/data
VOLUME ["/config", "/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/samishisa", "healthcheck"]
USER 1000:1000
ENTRYPOINT ["/samishisa"]
CMD ["serve"]
